danger {
    fs.write("windows-smoke.txt", "hello")
    fs.append("windows-smoke.txt", "-windows")
    print(fs.read("windows-smoke.txt"))
    print(fs.exists("windows-smoke.txt"))
    fs.delete("windows-smoke.txt")
}

danger {
    dyn db = sqlite.open("windows-smoke.db")
    sqlite.exec(db, "CREATE TABLE IF NOT EXISTS checks (value INTEGER)")
    sqlite.exec(db, "DELETE FROM checks")
    sqlite.exec(db, "INSERT INTO checks (value) VALUES (7)")
    dyn rows = sqlite.query(db, "SELECT value FROM checks")
    dyn row = rows[0]
    print(row[0])
    sqlite.close(db)
    fs.delete("windows-smoke.db")
}

dyn digest = crypto.hash("fluxa-windows")
