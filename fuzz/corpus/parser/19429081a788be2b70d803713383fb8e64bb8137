fn selection_sort(int arr a, int n) nil {
    int i = 0
    while i < n - 1 {
        int min_idx = i
        int j = i + 1
        while j < n {
            if a[j] < a[min_idx] {
                min_idx = j
            }
            j = j + 1
        }
        if min_idx != i {
            int tmp = a[i]
            a[i] = a[min_idx]
            a[min_idx] = tmp
        }
        i = i + 1
    }
}

