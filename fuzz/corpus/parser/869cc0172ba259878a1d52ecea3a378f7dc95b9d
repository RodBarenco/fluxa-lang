// LIFO: Last In, First Out.
// Implementation: static array with toxa run examples/data_structures/stack.flx

Block Stack {
    int arr data[64] = 0
    int top = -1

    fn push(int val) nil {
        if top >= 63 {
            print("ERRO: stack overflow")
            return
        }
        top = top + 1
        data[top] = val
    }

    fn pop() int {
        if top < 0 {
            print("ERRO: stack underflow")
            return -1
        }
        int val = data[top]
        top = top - 1
        return val
    }

    fn peek() int {
        if top < 0 {
            return -1
             return
        }
        int i = top
        while i >= 0 {
            print(data[i])
            i = i - 1
        }
    }
}

