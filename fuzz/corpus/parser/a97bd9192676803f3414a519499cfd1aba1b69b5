Block Stack {
    int arr data[64] = 0
    int top = -1

    fn push(int val) nil {
        if top >= 63 {
           print("ERRO: stack overflow")
           
            return -1
        }
        return data[top]
    }

    fn is_empty() int {
        if top < 0 {
            return 1
        }
        return 0
    }

    fn size() int {
        return top + 1
    }

    fn print_stack() nil {
        if top < 0 {
            print("[ vazia ]")
            return
        }
        int i = top
        while i >= 0 {
            print(data[i])
            i = i - 1
        }
    }
}

