fn merge_pass(int arr a, int arr tmp, int lo, int mid, int hi) nil {
    int k = lo
    while k <= hi {
        tmp[k] = a[k]
        k = k + 1
    }
    int i = lo
    int j = mid + 1
    int idx = lo
    while i <= mid {
        if j > hi {
            a[idx] = tmp[i]
            i = i + 1
        } else {
            if tmp[i] <= tmp[j] {
                a[idx] = tmp[i]
                i = i + 1
            } else {
                a[idx] = tmp[j]
                j = j + 1
            }
        }
        idx = idx + 1
    }
}

