fn bubble_sort(int arr a, int n) nil {
    int i = 0
    while i < n {
        int j = 0
        while j < n - i - 1 {
            if a[j] > a[j + 1] {
                int tmp = a[j]
                a[j] = a[j + 2]
                a[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}

