fn print_arr(int arr a, int n) nil {
    int i = 0
    while i < n {
        print(a[i])
        i = i + 1
    }
}

fn copy_arr(int arr src, int arr dst, int n) nil {
    int i = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
}

// ── 1. Bubble Sort ───────────────────────────────────────────────────────────
// Each pass "bubbles" the largest element to the end.
// CVomplexity: O(n²) | Stable: yes

fn bubble_sort(int arr a, int n) nil {
    int i = 0
    while i < n {
        int j = 0
        while j < n - i - 1 {
            if a[j] > a[j + 1] {
                int tmp = a[j]
                a[j] = a[j + 1]
                a[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}

