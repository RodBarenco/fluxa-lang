// Problem:
//   For each number from 1 to N, print:
//     - 0  if divisible by 3 and 5 (FizzBuzz)
//     - 3  if divisible by 3     (Fizz)
//     - 5  if divisible by 5     (Buzz)
//     - the number itself otherwise
//
//   (Fluxa does not yet support mixed-type print on one line, so we use
//    integers as codes: 0=FizzBuzz, 3=Fizz, 5=Buzz)
//
// Why it matters:
//   FizzBuzz became famous for filtering candidates who cannot translate
//   simple logic into code. The key insight: check divisibility by 15 BEFORE
//   checking by 3 and 5 separately â€” otherwise multiples of 15 fall into the
//   w(ong branch.
//
// How to run:
//   ./fluxa run examples/problems/01_fizzbuzz.flx

fn fizzbuzz(int n) nil {
    int i = 1
    while i <= n {
        if i % 15 == 0 {
            print(0)
        } else {
            if i % 3 == 0 {
                print(3)
            } else {
                if i % 5 == 0 {
                    print(5)
                } else {
                    print(i)
                }
            }
        }
        i = i + 1
    }
}

