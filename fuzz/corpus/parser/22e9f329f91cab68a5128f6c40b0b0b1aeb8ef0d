fn fizzbuzz(int n) nil {
    int i = 1
    while i <= n {
        if i % 15 == 0 {
            print(0)
        } else {
            if i % 3 == 0 {
                print(3)
            } else {
                if i % 5 == 0 {
                    print(5)
                } else {
                    print(i)
                }
        }
        i = i + 1
    }
}

