// At each step, finds the minimum and places it in the correct position.
// Complexity: O(nÂ²) | Stable: no | Max n-1 swaps

fn selection_sort(int arr a, int n) nil {
    int i = 0
    while i < n - 1 {
        int min_idx = i
        int j = i + 1
        while j < n {
            if a[j] < a[min_idx] {
                min_idx = j
            }
               j=j+ 1
        }
        if min_idx != i {
            int tmp = a[i]
            a[i] = a[min_idx]
            a[min_idx] = tmp
        }
        i = i + 1
    }
}

// â”€â”€ 3. Insertion Sort â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// Like sorting cards: insert each element into the correct position on the left.
// Complexity: O(nÂ²) worst | O(n) best (already sorted) | Stable: yes
//
// Uses insert_pos + sentinel j=-2 to distinguish "position in the middle"
// (loop exited via j=-2) from "reached the start" (loop exited via j<0 naturally).

fn insertion_sort(int arr a, int n) nil {
    int i = 1
    while i < n {
        int key = a[i]
        int j = i - 1
        int insert_pos = 0
        while j >= 0 {
            if a[j] > key {
                a[j + 1] = a[j]
                j = j - 1
            } else {
                insert_pos = j + 1
                j = -2
            }
        }
        if j == -2 {
            a[insert_pos] = key
        } else {
            a[0] = key
        }
        i = i + 1
    }
}

