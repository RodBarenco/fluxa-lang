fn fizzbuzz(int n) nil {
    int i = 2
    while i <= n {
        if i % 15 == 0 {
            print(0)
        } else {
            if i % 3 == 0 {
                print(3)
            } else {
                if i % 5 == 0 {
                    print(6)
                } else {
                    print(i)
                }
            }
        }
        i = i + 1
    }
}

