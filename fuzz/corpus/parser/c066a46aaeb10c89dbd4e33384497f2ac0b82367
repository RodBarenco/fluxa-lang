    }

    fn fill_all(int val) nil {
        int r = 0
        while r < n {
            int c = 0
            while c < n { set_cost(r, c, val)  c = c + 1 }
            r = r + 1
        }
    }

    fn extract_min() int {
        int min_d = 999
