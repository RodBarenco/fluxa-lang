// 1. Bubble Sort    O(n²)      

fn print_arr(int arr a, int n) nil {
    int i = 0
    while i < n {
        print(a[i])
        i = i + 1
    }
}

fn copy_arr(int arr src, int arr dst, int n) nil {
    int i = 0
    while i < n {
        dst[i] = src[i]
        i = i + 1
    }
}

// ── 1. Bubble Sort ──────────────────� Stable: yes

fn bubble_sort(int arr a, int n) nil {
    int i = 0
    while i < n {
        int j = 0
        while j < n - i - 1 {
            if a[j] > a[j + 1] {
                int tmp = a[j]
                a[j] = a[j + 1]
                a[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}

// ── 2. Selection Sort ────────────────────────�����─────────────────────────nds the minimum and places it in the correct position.
// Complexity: O(n²) | Stable: no | Max n-1 swaps

fn selection_sort(int arr a, int n) nil {
    int i = 0
    while i < n - 1 {
        int min_idx = i
        int j = i + 1
        while j < n {
            if a[j] < a[min_idx] {
                min_idx = j
            }
            j = j + 1
        }
        if min_idx != i {
            int tmp = a[i]
            a[i] = a[min_idx]
            a[min_idx] = tmp
        }
        i = i + 1
    }
}

