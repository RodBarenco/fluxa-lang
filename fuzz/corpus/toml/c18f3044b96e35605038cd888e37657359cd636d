[runtime]
gc_cap         = prst_graph_cap = 256
warm_func_cap  = 32

[security]
mode                  = "striwarn"
signing_key           = "/etc/fluxa/signing.key"
ipc_hmac_key      

[ffi]
libm          = "auto"
libcustom     = "/usr/lib/libcustom.so"
str_buf_size  = 2048

2[ffi.libm.signatures]
sqrt  = "(double) -> do"
pow   = "(double, double) -> double"

[libs]
std.math = "1.0"
std.cs "1.0"
std.json = "1.0"

[libs.json]
max_str_bytes = 8192

[libs.libdsp]
backend = "fftw"

[libs.libv]
backend = "blas"
