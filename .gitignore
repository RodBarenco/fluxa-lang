# Fluxa — .gitignore

# Binários nativos
fluxa
fluxa.exe
/fluxa-*.exe
/dist/
/.deps/
/.build-tmp/
/.builder-validation-registry/
fluxa_asan
fluxa_debug

# Binários embedded (gerados por make build-rp2040 / build-esp32)
fluxa-rp2040
fluxa-esp32
fluxa-cortex-m
*.o
*.elf
*.uf2
*.bin
*.hex
*.map

# Artefatos de teste temporários
/tmp/fluxa-*.sock
/tmp/fluxa-*.lock
/tmp/_fluxa_*.flx

# Editor
*.swp
*.swo
.DS_Store
-e 
fluxa_dis
fluxa_dbg
fluxa_asan
*.dis
fluxa_secure
fluxa_dis

# Fuzz build + findings (fuzz/corpus/ is checked in)
/fuzz/build/
/fuzz/findings/
fuzz/corpus/
/fuzz/crash-*
/fuzz/leak-*
/fuzz/timeout-*
/fuzz/oom-*
